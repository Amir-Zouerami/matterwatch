# Copy to .env and fill in. Never commit real values.

# ── required ──
MM_TOKEN=                  # access token of the Mattermost bot (System Admin role)
MM_TEAM_NAME=              # team where /gl is registered
MM_UPDATES_CHANNEL_ID=     # channel that receives the cards
GITLAB_TOKEN=              # glpat-… (scope `api`, role Maintainer; `read_api` for read-only)
GITLAB_WEBHOOK_SECRET=     # random string; the same value goes in the GitLab webhooks

# ── how things reach each other ──
GITLAB_URL=https://gitlab.com
MM_URL=http://mattermost:8065          # Mattermost, as Matterwatch can reach it
SERVICE_URL=http://matterwatch:3000         # Matterwatch, as Mattermost can reach it (buttons, /gl)

# ── optional ──
# ACTION_SIGNING_SECRET=   # signs button callbacks (defaults to the webhook secret)
# ADMIN_TOKEN=             # enables the /admin API
# METRICS_TOKEN=           # protects /metrics
# MM_WATCH_CHANNEL_IDS=    # extra channels where pasted GitLab links are watched (comma list)
# IGNORE_USERS=renovate,ci-bot
# MASK_LITERALS=           # extra strings to mask in posted logs
# TZ_NAME=UTC              # dates, quiet hours, digests (e.g. Europe/Berlin)
# QUIET_HOURS_START=23
# QUIET_HOURS_END=8
# DIGEST_HOUR=9
# FAILURE_LOG_LINES=40
# WATCH_TTL_HOURS=72
# POLL_INTERVAL_SECONDS=45
# LOG_LEVEL=info
